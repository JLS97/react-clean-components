<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules for Android 12 (API 31) and higher. Everything is included by
    default; add <include>/<exclude> entries to change that.
    https://developer.android.com/identity/data/autobackup
-->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
