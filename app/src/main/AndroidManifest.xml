<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- Only to read the QR code of a 2FA key, when the user asks to scan one. With no INTERNET
         permission, the image can't leave the phone; it is not stored either. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- Lets the autofill service read the signing certificate of the app asking to be filled, so
         a fake app can't pass for the real one or for a browser. The app being filled isn't
         visible otherwise. Without INTERNET this information never leaves the phone, and the app
         isn't published on Google Play, whose policy restricts this permission. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- No network access, ever: removes these even if a library tries to add them. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:name=".BovedaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">
        <!-- allowCrossUidActivitySwitchFromBelow="false" (Android 15+): una actividad de otra app que
             esté debajo en la misma tarea no puede lanzar nada encima de las de Bóveda (M-04). -->
        <activity
            android:name=".MainActivity"
            android:allowCrossUidActivitySwitchFromBelow="false"
            android:exported="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            tools:targetApi="35">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Opened only by the system, through Bóveda's own pending intents. -->
        <activity
            android:name=".autofill.AutofillActivity"
            android:allowCrossUidActivitySwitchFromBelow="false"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            tools:targetApi="35" />

        <!-- Only the system can bind to it (BIND_AUTOFILL_SERVICE). It works entirely on the phone. -->
        <service
            android:name=".autofill.BovedaAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>
    </application>

</manifest>
